            "text": "{\n  \"asBuilt\": {\n    \"fieldModal\": {\n      \"description\": \"Подсказка\"\n    },\n    \"fieldType\": {\n      \"Boolean\": \"Да/Нет\",\n      \"DateRange\": \"Диапазон дат\",\n      \"DateTime\": \"Дата и время\",\n      \"File\": \"Файл\",\n      \"FormSource\": \"Значение из источника\",\n      \"Numeric\": \"Число\",\n      \"Selection\": \"Список вариантов\",\n      \"String\": \"Строка\"\n    }\n  },\n  \"errors\": {\n    \"FormFieldTypeNameAlreadyExists\": \"Поле с таким названием уже существует\",\n    \"FormFieldTypeSystemNameAlreadyExists\": \"Поле с таким системным именем уже существует\",\n    \"FormTypeGroupNameAlreadyExists\": \"Группа типов форм с таким названием уже существует\",\n    \"FormTypeNameAlreadyExists\": \"Тип формы с таким названием уже существует\",\n    \"FormTypePrefixAlreadyExists\": \"Тип формы с таким префиксом уже существует\",\n    \"ProjectFormFieldDateRangeValueIsInvalid\": \"Некорректный диапазон дат в поле \\\"{{value}}\\\"\",\n    \"ProjectFormFieldNumericValueOutOfRange\": \"Числовое значение поля \\\"{{value}}\\\" не входит в допустимый диапазон\",\n    \"ProjectFormFieldSelectionContainsUnknownOptions\": \"Поле \\\"{{value}}\\\" содержит неизвестные варианты выбора\",\n    \"ProjectFormFieldStringValueDoesNotMatchRegex\": \"Значение поля \\\"{{value}}\\\" не соответствует допустимому формату\",\n    \"ProjectFormFieldValueHasIncorrectKind\": \"Некорректный тип значения поля  \\\"{{value}}\\\"\",\n    \"ProjectFormFieldValueIsNotUnique\": \"Значение поля \\\"{{value}}\\\" должно быть уникальным в рамках проекта\"\n  },\n  \"fieldModal\": {\n    \"allowedValues\": {\n      \"title\": \"Допустимые значения\"\n    },\n    \"descriptionTooltip\": \"Отображается при заполнении формы, если навести на поле\",\n    \"fieldSettings\": {\n      \"AllowedNumericValuesTooltip\": \"Диапазонов может быть несколько, в этом случае значение поля должно попадать хотя бы в один из них\",\n      \"AllowedStringValuesTooltip\": \"Маска отображается в виде подсказки в значении поля при заполнении формы.  Текст ошибки отображается, если значение поля не соответствует регулярному выражению\",\n      \"RangeBoundaries\": \"Границы диапазона\",\n      \"allowMultiple\": \"Несколько значений\",\n      \"boundaryType\": {\n        \"Closed\": \"Оба включать\",\n        \"ClosedOpen\": \"Включать только минимум\",\n        \"Open\": \"Оба не включать\",\n        \"OpenClosed\": \"Включать только максимум\"\n      },\n      \"currentDate\": \"Текущая дата\",\n      \"date\": \"Дата\",\n      \"days\": \"Дней\",\n      \"defaultValue\": \"Значение по умолчанию\",\n      \"errorText\": \"Текст ошибки\",\n      \"formSet\": \"Набор форм\",\n      \"mask\": \"Маска\",\n      \"optionName\": \"Название варианта\",\n      \"options\": \"Варианты ответа\",\n      \"reqexp\": \"Регулярное выражение\",\n      \"required\": \"Обязательное к заполнению\",\n      \"shiftDate\": \"Сдвиг от текущей даты\",\n      \"step\": \"Шаг\",\n      \"switchIsOnByDefault\": \"Переключатель по умолчанию включен\",\n      \"time\": \"Время\",\n      \"title\": \"Настройки поля\",\n      \"unit\": \"Единицы измерения\",\n      \"useAsDisplayValue\": \"Используется в названии формы\",\n      \"useAsRegistryColumn\": \"Отображается в реестре\"\n    },\n    \"fieldValue\": {\n      \"allowMultiple\": \"Можно выбрать несколько значений\"\n    },\n    \"formSetTooltip\": \"При заполнении поля можно выбрать записи, которые соответствуют заданным формам и фильтрам (при наличии). Значения по умолчанию можно задать в реестре записей\",\n    \"systemNameTooltip\": \"Используется в шаблонах для генерации документов из записей\"\n  },\n  \"fieldSettings\": {\n    \"from\": \"От\",\n    \"to\": \"До\"\n  },\n  \"fields\": {\n    \"errors\": {\n      \"dateRangeIncomplete\": \"Нужно заполнить и дату начала, и дату конца\",\n      \"dateRangeInvalid\": \"Дата начала должна быть не позже, чем дата конца\",\n      \"numericValueInvalid\": \"Число не соответствует допустимым значениям\",\n      \"regexInvalid\": \"Текст не соответствует допустимым значениям\"\n    },\n    \"personName\": {\n      \"firstName\": \"Имя\",\n      \"lastName\": \"Фамилия\",\n      \"middleName\": \"Отчество\"\n    },\n    \"string\": {\n      \"unit\": {\n        \"Ampere\": \"А\",\n        \"Atmosphere\": \"атм\",\n        \"Bar\": \"бар\",\n        \"Centimeter\": \"см\",\n        \"CubicCentimeter\": \"см³\",\n        \"CubicMeter\": \"м³\",\n        \"Day\": \"дн\",\n        \"Decibel\": \"дБ\",\n        \"Decimeter\": \"дм\",\n        \"DegreesCelsius\": \"°C\",\n        \"Gram\": \"г\",\n        \"GramPerLiter\": \"г/л\",\n        \"Horsepower\": \"л. с.\",\n        \"Hour\": \"ч\",\n        \"Joule\": \"Дж\",\n        \"Kelvin\": \"К\",\n        \"Kilogram\": \"кг\",\n        \"KilogramForcePerSquareCentimeter\": \"кгс/см²\",\n        \"KilogramPerCubicMeter\": \"кг/м³\",\n        \"KilogramPerSquareMeter\": \"кг/м²\",\n        \"Kilometer\": \"км\",\n        \"KilometerPerHour\": \"км/ч\",\n        \"Kilonewton\": \"кН\",\n        \"Kilowatt\": \"кВт\",\n        \"KilowattHour\": \"кВт⋅ч\",\n        \"Liter\": \"л\",\n        \"LiterPerSecond\": \"л/с\",\n        \"MachineHour\": \"маш.-ч\",\n        \"ManHour\": \"чел.-ч\",\n        \"Megapascal\": \"МПа\",\n        \"Meter\": \"м\",\n        \"MeterPerSecond\": \"м/с\",\n        \"Micrometer\": \"мкм\",\n        \"MilligramPerLiter\": \"мг/л\",\n        \"Millimeter\": \"мм\",\n        \"MillimeterOfMercury\": \"мм рт. ст.\",\n        \"Minute\": \"мин\",\n        \"Month\": \"мес\",\n        \"Newton\": \"Н\",\n        \"NewtonMeter\": \"Н·м\",\n        \"Package\": \"уп.\",\n        \"Pascal\": \"Па\",\n        \"Percent\": \"%\",\n        \"Piece\": \"шт.\",\n        \"RevolutionsPerMinute\": \"об/мин\",\n        \"RunningMeter\": \"пог. м\",\n        \"Second\": \"с\",\n        \"Set\": \"компл.\",\n        \"SquareCentimeter\": \"см²\",\n        \"