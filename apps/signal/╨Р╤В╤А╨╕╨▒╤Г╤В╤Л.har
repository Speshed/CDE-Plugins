            "text": "{\n  \"addTask\": \"Добавить задачу\",\n  \"changeTreeLevel\": \"Изменить уровень дерева\",\n  \"columns\": {\n    \"addColumn\": {\n      \"add\": \"Добавить\",\n      \"addButton\": \"Добавить колонку\",\n      \"alreadyExists\": \"Колонка \\\"{{columnLabel}}\\\" уже существует!\",\n      \"cancel\": \"Отмена\",\n      \"columnLabel\": \"Название колонки\",\n      \"columnLabelError\": \"Введите название колонки\",\n      \"columnLabelPlaceholder\": \"Например: Приоритет\",\n      \"fieldName\": \"Имя поля (опционально)\",\n      \"fieldNameHelper\": \"Если не указано, будет сгенерировано автоматически\",\n      \"fieldNamePlaceholder\": \"Например: priority\",\n      \"title\": \"Добавить новую колонку\"\n    },\n    \"cost\": \"Цена за ед.\",\n    \"count\": \"Кол-во\",\n    \"done\": {\n      \"count\": \"Кол-во\",\n      \"date\": \"Дата\",\n      \"exceedsLimit\": \"Превышен лимит: {{totalDone}} > {{maxCount}}\",\n      \"noEntries\": \"Нет данных\",\n      \"title\": \"Выполнено\"\n    },\n    \"duration\": \"Длительность\",\n    \"end\": \"Конец\",\n    \"name\": \"Название\",\n    \"paid\": \"Оплачено\",\n    \"progress\": \"Прогресс\",\n    \"start\": \"Начало\",\n    \"total\": \"Цена итого\",\n    \"units\": \"Ед. изм.\",\n    \"validation\": {\n      \"invalidDate\": \"Дата должна быть в диапазоне от 01.01.1900 до 31.12.2100\",\n      \"lessThanDone\": \"Количество не может быть меньше уже указанного «Выполнено»\"\n    },\n    \"wbs\": \"ИСР\"\n  },\n  \"completedWorks\": \"Выполненные работы\",\n  \"confirmLeafToGroup\": {\n    \"text\": \"Задача {{taskName}} превращается в группу. Данные с объемами и стоимостью будут удалены. Вы уверены?\",\n    \"title\": \"⚠️ Внимание\"\n  },\n  \"continueEditing\": \"Продолжить редактировать\",\n  \"deleteLink\": \"Удалить связь\",\n  \"deleteLinkTitle\": \"Удаление связи\",\n  \"deleteTask\": \"Удалить задачу\",\n  \"deleteTasks\": \"Удалить задачи ({{count}})?\",\n  \"excludeWeekends\": \"Ис